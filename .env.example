# Google AI Studio key: https://aistudio.google.com/apikey  (free, no credit card)
#
# Gemini rate limits are enforced PER PROJECT, not per key — a new key inside a
# project you already use buys zero extra headroom. Create this key in its own
# Google Cloud project so it does not eat your other projects' quota.
GEMINI_API_KEY=

# Optional. Never hardcode a model id in source — this app already died once
# when GitHub Models retired the one it was pinned to.
# VISION_MODEL=gemini-3.5-flash-lite

# Each photo costs TWO requests by default. Two ways to cut that:
#
#   RECONCILE=0            skip the second pass entirely — 1 request per photo,
#                          at some cost to accuracy. Measure it on your photos.
#
#   RECONCILE_MODEL=...    keep both passes but send the second to a DIFFERENT
#                          model. Free-tier quota is bucketed per project per
#                          model, so the two calls then draw from separate
#                          daily pools instead of halving your photo budget.
#                          Defaults to VISION_MODEL (one shared pool).
# RECONCILE=1
# RECONCILE_MODEL=gemini-3.8-flash

# PORT=3000

# ---------------------------------------------------------------- sign-in
#
# Both are verify-only: the server checks the provider's signature and hands
# the `sub` claim back to the browser, which uses it to name a localStorage
# bucket. No secret is needed for either, because no authorization code is ever
# exchanged — and no food log ever reaches the server.

# Google Cloud console -> Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI must be <origin>/landing.html, character for
# character. Leave unset and the button still shows, but says it is unwired.
GOOGLE_CLIENT_ID=

# The Services ID from developer.apple.com — not the App ID, and not the Team
# ID. Needs a paid membership and a domain Apple has verified over HTTPS, so
# localhost cannot test it.
#
# Leave this unset and the Apple button is not rendered at all. That is the
# intended way to ship without Apple sign-in; there is no separate flag.
# APPLE_SERVICE_ID=
