# Google AI Studio key: https://aistudio.google.com/apikey  (free, no credit card)
#
# Gemini rate limits are enforced PER PROJECT, not per key — a new key inside a
# project you already use buys zero extra headroom. Create this key in its own
# Google Cloud project so it does not eat your other projects' quota.
GEMINI_API_KEY=

# Optional. Never hardcode a model id in source — this app already died once
# when GitHub Models retired the one it was pinned to.
# VISION_MODEL=gemini-3.5-flash-lite

# Each photo costs TWO requests by default. Two ways to cut that:
#
#   RECONCILE=0            skip the second pass entirely — 1 request per photo,
#                          at some cost to accuracy. Measure it on your photos.
#
#   RECONCILE_MODEL=...    keep both passes but send the second to a DIFFERENT
#                          model. Free-tier quota is bucketed per project per
#                          model, so the two calls then draw from separate
#                          daily pools instead of halving your photo budget.
#                          Defaults to VISION_MODEL (one shared pool).
# RECONCILE=1
# RECONCILE_MODEL=gemini-3.8-flash

# PORT=3000

# ---------------------------------------------------------------- sign-in
#
# Both are verify-only: the server checks the provider's signature and hands
# the `sub` claim back to the browser, which uses it to name a localStorage
# bucket. No secret is needed for either, because no authorization code is ever
# exchanged — and no food log ever reaches the server.

# Google Cloud console -> Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI must be <origin>/landing.html, character for
# character. Leave unset and the button still shows, but says it is unwired.
GOOGLE_CLIENT_ID=

# The Services ID from developer.apple.com — not the App ID, and not the Team
# ID. Needs a paid membership and a domain Apple has verified over HTTPS, so
# localhost cannot test it.
#
# Leave this unset and the Apple button is not rendered at all. That is the
# intended way to ship without Apple sign-in; there is no separate flag.
# APPLE_SERVICE_ID=

# ------------------------------------------------- server-side authorization
#
# /api/analyze spends TWO Gemini requests per photo, so it is the one route
# that checks who is asking. After Google or Apple verifies someone, the server
# mints its own JWT signed with this secret; the browser sends it back as a
# bearer token. Nothing is stored server-side — the signature is the record.
#
# REQUIRED in production. Without it the server cannot issue sign-ins, and on
# Vercel it refuses outright rather than half-working. Locally it falls back to
# a random per-process secret (every restart signs you out) with a warning.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# How long a sign-in lasts before the browser must reauthenticate.
# SESSION_TTL=30d

# Per-identity ceilings on photo analysis, so one account cannot drain the
# day's free-tier quota for everyone. Counted in memory, so on a serverless
# host the real ceiling is this times the number of warm instances.
# ANALYZE_PER_HOUR=20
# ANALYZE_PER_DAY=60

# Set to 0 to make /api/analyze public again. This is not a weaker gate, it is
# no gate — anyone who finds the URL can spend your Gemini quota. Local
# convenience only; never set this on a deployed instance.
# ANALYZE_REQUIRES_SIGNIN=1

# --------------------------------------------------------------- rate limits
#
# Sliding windows held in this process's memory. On a serverless host the real
# ceiling is these numbers times the number of warm instances, and a cold start
# forgets everything — still the difference between "a loop drains the day's
# quota in a minute" and "it cannot". An exact global limit needs a shared
# datastore, which this app deliberately does not have.
#
# Photo analysis, counted per signed-in account (not per address, so a shared
# network is not one budget and roaming does not buy a fresh one).
# ANALYZE_PER_HOUR=20
# ANALYZE_PER_DAY=60

# Sign-in attempts per address. Unauthenticated and does real work — a JWKS
# fetch on a cold instance, then a signature check.
# AUTH_PER_MINUTE=10
# AUTH_PER_HOUR=60

# /api/auth/config — cheap, but public.
# CONFIG_PER_MINUTE=60

# /api/health reaches Google to check the vision model, so it is capped tightly
# and the result is cached. The cache is the real protection; the cap is the
# backstop for the first hit of each period.
# HEALTH_PER_MINUTE=6
# HEALTH_PER_HOUR=60
# HEALTH_CACHE_MS=30000

# Backstop across every /api route, per address, so a route added later is
# never wide open. Loose on purpose — the per-route caps are what should bind.
# API_PER_MINUTE=120
# API_PER_HOUR=1200

# Only when a reverse proxy you control sits in front of this app: makes the
# limiter read X-Forwarded-For for the client address. Off by default, because
# trusting it blindly lets any caller rotate the header past every limit. On
# Vercel this is unnecessary — the platform's own header is used automatically.
# TRUST_PROXY=1
