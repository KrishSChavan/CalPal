# Google AI Studio key: https://aistudio.google.com/apikey  (free, no credit card)
GEMINI_API_KEY=

# Optional. Never hardcode a model id in source — this app already died once
# when GitHub Models retired the one it was pinned to.
# VISION_MODEL=gemini-3.5-flash-lite

# Set to 0 to skip the reconciliation pass. That halves requests per photo
# (2 -> 1), which is what matters if this key shares a free-tier quota with
# your other projects. Costs some accuracy; measure it on your own photos.
# RECONCILE=1

# PORT=3000
