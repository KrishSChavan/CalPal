{
  "name": "calpal",
  "version": "1.0.0",
  "description": "Photograph a meal, get a calorie count cross-referenced against USDA FNDDS.",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "devStart": "nodemon index.js",
    "build:fndds": "node scripts/build-fndds.js",
    "test:db": "node server/food-db.test.js",
    "test": "node --test \"test/*.test.*\" \"server/*.test.js\"",
    "test:storage": "node --test test/storage.test.mjs",
    "test:api": "node --test test/api.test.js",
    "test:vision": "node server/vision.test.js",
    "test:db:adv": "node server/food-db.adversarial.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "openai": "^5.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
